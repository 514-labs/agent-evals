def log(argv, result, exit_code):
    path = os.environ.get("MOOSE_LOG_PATH", "/tmp/cli-structure-test/moose.log")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    entry = {
        "ts": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "variant": VARIANT,
        "argv": argv,
        "result": result,
        "exit_code": exit_code,
    }
    with open(path, "a") as f:
        f.write(json.dumps(entry) + "\n")


def top_help():
    out = ["Moose CLI (simulated FLAG variant) - flat verbs, category-as-flag",
           "",
           "Usage: moose <VERB> [FLAGS]",
           "",
           "Verbs:"]
    for v, meta in TOP.items():
        out.append(f"  {v:<11} {meta['desc']}")
    out.append("")
    out.append("Run `moose <verb> --help` for its flags.")
    return "\n".join(out) + "\n"


def suggest(token, candidates):
    token_l = token.lower()
    for c in candidates:
        if token_l == c.lower() or token_l in c.lower() or c.lower() in token_l:
            return c
    best, best_score = None, 0
    for c in candidates:
        score = len(set(token_l) & set(c.lower()))
        if score > best_score:
            best, best_score = c, score
    return best if best_score >= max(2, len(token) // 2) else None


def find_flag_value(argv, flag):
    """Return value for --flag <value> or None."""
    for i, a in enumerate(argv):
        if a == flag and i + 1 < len(argv):
            return argv[i + 1]
        if a.startswith(flag + "="):
            return a.split("=", 1)[1]
    return None


def main(argv):
    if len(argv) == 0 or argv[0] in ("-h", "--help", "help"):
        sys.stdout.write(top_help())
        log(argv, "help:top", 0)
        return 0

    verb = argv[0]
    if verb not in TOP:
        s = suggest(verb, list(TOP.keys()))
        hint = f"\n\nDid you mean `moose {s}`?" if s else ""
        sys.stderr.write(f"error: unknown command '{verb}'{hint}\n")
        sys.stderr.write("Run `moose --help` to see all verbs.\n")
        log(argv, "error:unknown", 2)
        return 2

    rest = argv[1:]
    if rest and rest[0] in ("-h", "--help"):
        sys.stdout.write(TOP[verb]["help"])
        log(argv, f"help:verb:{verb}", 0)
        return 0

    meta = TOP[verb]

    if "dispatch" in meta:
        flag, actions = meta["dispatch"]
        val = find_flag_value(rest, flag)
        if val is None:
            # Handle docs root (no --action)
            if verb == "docs":
                sys.stdout.write("Documentation index (collapsed).\n")
                log(argv, "matched:docs", 0)
                return 0
            sys.stderr.write(f"error: `moose {verb}` requires {flag} <VALUE>.\n")
            sys.stderr.write(f"Known values: {', '.join(actions.keys())}\n")
            log(argv, "error:incomplete", 2)
            return 2
        if val not in actions:
            s = suggest(val, list(actions.keys()))
            hint = f"\n\nDid you mean `moose {verb} {flag} {s}`?" if s else ""
            sys.stderr.write(f"error: unknown {flag} value '{val}'{hint}\n")
            log(argv, "error:unknown", 2)
            return 2
        cap, out = actions[val]
        if cap == "harness:init":
            name = find_flag_value(rest, "--name")
            if name and not name.startswith("-"):
                os.makedirs(name, exist_ok=True)
                with open(os.path.join(name, "moose.config.toml"), "w") as f:
                    f.write(f'name = "{name}"\n')
        sys.stdout.write(out + "\n")
        log(argv, f"matched:{cap}", 0)
        return 0

    # Plain verb
    cap, out_tmpl = meta["cap"], meta["out"]
    if cap == "init":
        name = find_flag_value(rest, "--name")
        if name and not name.startswith("-"):
            os.makedirs(name, exist_ok=True)
            with open(os.path.join(name, "moose.config.toml"), "w") as f:
                f.write(f'name = "{name}"\n')
            sys.stdout.write(out_tmpl.format(name=name) + "\n")
        else:
            sys.stdout.write(out_tmpl.format(name="project") + "\n")
    else:
        sys.stdout.write(out_tmpl + "\n")
    log(argv, f"matched:{cap}", 0)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
