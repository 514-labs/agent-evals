def log(argv, result, exit_code):
    path = os.environ.get("MOOSE_LOG_PATH", "/workspace/moose.log")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    entry = {
        "ts": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "variant": VARIANT,
        "argv": argv,
        "result": result,
        "exit_code": exit_code,
    }
    with open(path, "a") as f:
        f.write(json.dumps(entry) + "\n")


def top_help():
    out = ["Moose CLI (simulated SHALLOW variant) - top-level verbs, some subcommand trees",
           "",
           "Usage: moose <COMMAND> [ARGS] [OPTIONS]",
           "",
           "Commands:"]
    for verb, desc in TOP_DESCRIPTIONS.items():
        out.append(f"  {verb:<10} {desc}")
    out += ["",
            "Subcommanded: workflow, seed, template, harness, component, db, kafka, add, docs, generate",
            "Run `moose <command> --help` for options."]
    return "\n".join(out) + "\n"


def suggest(token, candidates):
    token_l = token.lower()
    for c in candidates:
        if token_l == c.lower() or token_l in c.lower() or c.lower() in token_l:
            return c
    best, best_score = None, 0
    for c in candidates:
        score = len(set(token_l) & set(c.lower()))
        if score > best_score:
            best, best_score = c, score
    return best if best_score >= max(2, len(token) // 2) else None


def main(argv):
    if len(argv) == 0 or argv[0] in ("-h", "--help", "help"):
        sys.stdout.write(top_help())
        log(argv, "help:top", 0)
        return 0

    verb = argv[0]
    if verb not in TOP_DESCRIPTIONS:
        s = suggest(verb, list(TOP_DESCRIPTIONS.keys()))
        hint = f"\n\nDid you mean `moose {s}`?" if s else ""
        sys.stderr.write(f"error: unknown command '{verb}'{hint}\n")
        sys.stderr.write("Run `moose --help` to see available commands.\n")
        log(argv, "error:unknown", 2)
        return 2

    if len(argv) >= 2 and argv[1] in ("-h", "--help"):
        sys.stdout.write(VERB_HELP[verb])
        log(argv, f"help:verb:{verb}", 0)
        return 0

    # Subtree dispatch
    if verb in SUBTREES:
        if len(argv) < 2:
            if verb == "docs":
                # docs with no args = show index
                sys.stdout.write(CAPABILITY_OUT["docs.root"][1] + "\n")
                log(argv, f"matched:{CAPABILITY_OUT['docs.root'][0]}", 0)
                return 0
            sys.stderr.write(f"error: `moose {verb}` requires a subcommand.\n")
            sys.stderr.write(f"Run `moose {verb} --help` to see subcommands.\n")
            log(argv, "error:incomplete", 2)
            return 2

        sub = argv[1]
        if sub not in SUBTREES[verb]:
            # docs is hybrid: non-subcommand first arg = slug
            if verb == "docs":
                cap, out = CAPABILITY_OUT["docs.root"]
                sys.stdout.write(f"{out} (slug: {sub})\n")
                log(argv, f"matched:{cap}", 0)
                return 0
            s = suggest(sub, list(SUBTREES[verb]))
            hint = f"\n\nDid you mean `moose {verb} {s}`?" if s else ""
            sys.stderr.write(f"error: unknown subcommand 'moose {verb} {sub}'{hint}\n")
            log(argv, "error:unknown", 2)
            return 2

        key = f"{verb}.{sub}"
        cap, out = CAPABILITY_OUT[key]
        if cap == "harness:init" and len(argv) >= 3 and not argv[2].startswith("-"):
            name = argv[2]
            os.makedirs(name, exist_ok=True)
            with open(os.path.join(name, "moose.config.toml"), "w") as f:
                f.write(f'name = "{name}"\n')
        sys.stdout.write(out + "\n")
        log(argv, f"matched:{cap}", 0)
        return 0

    # Flat verb
    cap, out_tmpl = CAPABILITY_OUT[verb]
    if cap == "init" and len(argv) >= 2 and not argv[1].startswith("-"):
        name = argv[1]
        os.makedirs(name, exist_ok=True)
        with open(os.path.join(name, "moose.config.toml"), "w") as f:
            f.write(f'name = "{name}"\n')
        sys.stdout.write(out_tmpl.format(name=name) + "\n")
    else:
        sys.stdout.write(out_tmpl + "\n")
    log(argv, f"matched:{cap}", 0)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
