#!/usr/bin/env python3
"""Simulated Moose CLI wrapper - POSITIONAL variant.

Flat top-level verbs. Where real Moose uses subcommands, a positional arg is used.
All help is dumped on `moose --help` - no per-subtree drill-down.

This does NOT invoke real Moose.
"""
import json
import os
import sys
from datetime import datetime, timezone

VARIANT = "positional"

