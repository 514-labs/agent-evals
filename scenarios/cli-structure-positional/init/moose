# Build lookup: (verb, subpos) -> row ; also verbs set and subpos-per-verb.
VERBS = {}
for row in COMMANDS:
    v = row[0]
    VERBS.setdefault(v, []).append(row)


def log(argv, result, exit_code):
    path = os.environ.get("MOOSE_LOG_PATH", "/workspace/moose.log")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    entry = {
        "ts": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "variant": VARIANT,
        "argv": argv,
        "result": result,
        "exit_code": exit_code,
    }
    with open(path, "a") as f:
        f.write(json.dumps(entry) + "\n")


def top_help():
    out = ["Moose CLI (simulated POSITIONAL variant) - flat verbs, category-as-positional",
           "",
           "Usage: moose <COMMAND> [POSITIONALS] [OPTIONS]",
           "",
           "All commands (positional categories shown inline):",
           ""]
    # Group by verb for readability
    for verb, rows in VERBS.items():
        for row in rows:
            v, sub, cap, _out, sig = row
            out.append(f"  {sig}")
    out.append("")
    out.append("Note: There is no per-subtree --help drill-down in this variant.")
    return "\n".join(out) + "\n"


def suggest(tokens, candidates_sigs):
    """Suggest a whole command line given tokens and candidate signatures (raw strings)."""
    best, best_score = None, 0
    for sig in candidates_sigs:
        sig_l = sig.lower()
        score = 0
        for t in tokens:
            t_l = t.lower()
            if t_l in sig_l:
                score += 3
            else:
                # fuzzy: substring-or-prefix against any word in sig
                for word in sig_l.split():
                    if t_l[: max(3, len(t_l) - 1)] == word[: max(3, len(t_l) - 1)]:
                        score += 1
                        break
                    if len(set(t_l) & set(word)) >= max(3, len(t_l) - 2):
                        score += 1
                        break
        if score > best_score:
            best, best_score = sig, score
    return best if best_score >= 1 else None


def main(argv):
    if len(argv) == 0 or argv[0] in ("-h", "--help", "help"):
        sys.stdout.write(top_help())
        log(argv, "help:top", 0)
        return 0

    verb = argv[0]
    if verb not in VERBS:
        # suggest full invocation
        sigs = [row[4] for row in COMMANDS]
        s = suggest([verb] + argv[1:2], sigs)
        hint = f"\n\nDid you mean `{s}`?" if s else ""
        sys.stderr.write(f"error: unknown command '{verb}'{hint}\n")
        sys.stderr.write("Run `moose --help` to see all commands.\n")
        log(argv, "error:unknown", 2)
        return 2

    rows = VERBS[verb]
    # Determine if verb requires a positional category
    has_subcat = any(r[1] is not None for r in rows)
    has_plain = any(r[1] is None for r in rows)

    rest = argv[1:]

    if has_subcat:
        # first positional picks the sub
        if not rest:
            if has_plain:
                # verb can stand alone (docs)
                plain = next(r for r in rows if r[1] is None)
                cap, out_tmpl = plain[2], plain[3]
                sys.stdout.write(out_tmpl + "\n")
                log(argv, f"matched:{cap}", 0)
                return 0
            sigs = [r[4] for r in rows]
            sys.stderr.write(f"error: `moose {verb}` requires a positional subcommand.\n")
            sys.stderr.write("Known forms:\n" + "\n".join(f"  {s}" for s in sigs) + "\n")
            log(argv, "error:incomplete", 2)
            return 2

        sub = rest[0]
        match = next((r for r in rows if r[1] == sub), None)
        if not match:
            if has_plain and not sub.startswith("-"):
                # interpret as positional arg for plain form (e.g., docs <SLUG>)
                plain = next(r for r in rows if r[1] is None)
                cap, out_tmpl = plain[2], plain[3]
                sys.stdout.write(f"{out_tmpl} (slug: {sub})\n")
                log(argv, f"matched:{cap}", 0)
                return 0
            known_subs = [r[1] for r in rows if r[1] is not None]
            # prefix-strip heuristic: handle "runs" -> "run", "lists" -> "list"
            s = None
            for k in known_subs:
                if sub.lower().startswith(k.lower()) or k.lower().startswith(sub.lower()):
                    s = f"moose {verb} {k}"
                    break
            if not s:
                s = suggest([sub], [f"moose {verb} {k}" for k in known_subs])
            hint = f"\n\nDid you mean `{s}`?" if s else ""
            sys.stderr.write(f"error: unknown invocation 'moose {verb} {sub}'{hint}\n")
            log(argv, "error:unknown", 2)
            return 2

        cap, out_tmpl = match[2], match[3]
        if cap == "harness:init" and len(rest) >= 2 and not rest[1].startswith("-"):
            name = rest[1]
            os.makedirs(name, exist_ok=True)
            with open(os.path.join(name, "moose.config.toml"), "w") as f:
                f.write(f'name = "{name}"\n')
        sys.stdout.write(out_tmpl + "\n")
        log(argv, f"matched:{cap}", 0)
        return 0

    # Plain verb
    plain = rows[0]
    cap, out_tmpl = plain[2], plain[3]
    if cap == "init" and rest and not rest[0].startswith("-"):
        name = rest[0]
        os.makedirs(name, exist_ok=True)
        with open(os.path.join(name, "moose.config.toml"), "w") as f:
            f.write(f'name = "{name}"\n')
        sys.stdout.write(out_tmpl.format(name=name) + "\n")
    else:
        sys.stdout.write(out_tmpl + "\n")
    log(argv, f"matched:{cap}", 0)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
