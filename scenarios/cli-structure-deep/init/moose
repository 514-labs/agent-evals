def log(argv, result, exit_code):
    path = os.environ.get("MOOSE_LOG_PATH", "/workspace/moose.log")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    entry = {
        "ts": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "variant": VARIANT,
        "argv": argv,
        "result": result,
        "exit_code": exit_code,
    }
    with open(path, "a") as f:
        f.write(json.dumps(entry) + "\n")


def top_help():
    out = ["Moose CLI (simulated DEEP variant) - 3-level namespacing",
           "",
           "Usage: moose <namespace> <command> [ARGS] [OPTIONS]",
           "",
           "Namespaces:"]
    for ns, meta in NAMESPACES.items():
        out.append(f"  {ns:<13} {meta['desc']}")
    out += ["",
            "Run `moose <namespace> --help` to see commands within that namespace.",
            "Run `moose <namespace> <command> --help` for per-command flags."]
    return "\n".join(out) + "\n"


def namespace_help(ns):
    meta = NAMESPACES[ns]
    out = [f"Moose CLI - {ns} namespace",
           "",
           f"  {meta['desc']}",
           "",
           f"Usage: moose {ns} <command> [ARGS] [OPTIONS]",
           "",
           "Commands:"]
    for cmd, desc in meta["commands"].items():
        out.append(f"  {cmd:<22} {desc}")
    out += ["", f"Run `moose {ns} <command> --help` for per-command flags."]
    return "\n".join(out) + "\n"


def leaf_help(ns, leaf):
    return LEAF_HELP[(ns, leaf)]


def suggest(token, candidates):
    # simple edit-distance-ish: prefix/substring match
    token_l = token.lower()
    for c in candidates:
        if token_l == c.lower() or token_l in c.lower() or c.lower() in token_l:
            return c
    # char-overlap fallback
    best, best_score = None, 0
    for c in candidates:
        score = len(set(token_l) & set(c.lower()))
        if score > best_score:
            best, best_score = c, score
    return best if best_score >= max(2, len(token) // 2) else None


def main(argv):
    if len(argv) == 0 or argv[0] in ("-h", "--help", "help"):
        sys.stdout.write(top_help())
        log(argv, "help:top", 0)
        return 0

    ns = argv[0]
    if ns not in NAMESPACES:
        s = suggest(ns, list(NAMESPACES.keys()))
        hint = f"\n\nDid you mean `moose {s}`?" if s else ""
        sys.stderr.write(f"error: unknown namespace '{ns}'{hint}\n")
        sys.stderr.write("Run `moose --help` to see available namespaces.\n")
        log(argv, "error:unknown", 2)
        return 2

    if len(argv) == 1:
        sys.stderr.write(f"error: `moose {ns}` requires a subcommand.\n")
        sys.stderr.write(f"Run `moose {ns} --help` to see commands.\n")
        log(argv, "error:incomplete", 2)
        return 2

    if argv[1] in ("-h", "--help", "help"):
        sys.stdout.write(namespace_help(ns))
        log(argv, f"help:namespace:{ns}", 0)
        return 0

    leaf = argv[1]
    leaves = list(NAMESPACES[ns]["commands"].keys())
    if leaf not in leaves:
        s = suggest(leaf, leaves)
        hint = f"\n\nDid you mean `moose {ns} {s}`?" if s else ""
        sys.stderr.write(f"error: unknown command 'moose {ns} {leaf}'{hint}\n")
        log(argv, "error:unknown", 2)
        return 2

    rest = argv[2:]
    if rest and rest[0] in ("-h", "--help"):
        sys.stdout.write(leaf_help(ns, leaf))
        log(argv, f"help:leaf:{ns}.{leaf}", 0)
        return 0

    cap, out_template = CAPABILITY[(ns, leaf)]

    # Minor shaping for init so output references the project name
    if cap == "init" and rest:
        name = rest[0]
        if not name.startswith("-"):
            os.makedirs(name, exist_ok=True)
            with open(os.path.join(name, "moose.config.toml"), "w") as f:
                f.write(f'name = "{name}"\n')
        sys.stdout.write(out_template.format(name=name) + "\n")
    elif cap == "harness:init" and rest and not rest[0].startswith("-"):
        name = rest[0]
        os.makedirs(name, exist_ok=True)
        with open(os.path.join(name, "moose.config.toml"), "w") as f:
            f.write(f'name = "{name}"\n')
        sys.stdout.write(out_template + "\n")
    else:
        sys.stdout.write(out_template + "\n")

    log(argv, f"matched:{cap}", 0)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
