def log(argv, result, exit_code):
    path = os.environ.get("MOOSE_LOG_PATH", "/workspace/moose.log")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    entry = {
        "ts": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "variant": VARIANT,
        "argv": argv,
        "result": result,
        "exit_code": exit_code,
    }
    with open(path, "a") as f:
        f.write(json.dumps(entry) + "\n")


def top_help():
    out = ["Moose CLI (simulated ATOMIC variant) - every capability is a top-level kebab-case verb",
           "",
           "Usage: moose <VERB> [ARGS] [OPTIONS]",
           "",
           "Commands (alphabetical):"]
    for verb in sorted(COMMANDS.keys()):
        cap, desc, _out, _sig = COMMANDS[verb]
        out.append(f"  moose {verb:<22} {desc}")
    out += ["",
            "No subtree help. Each verb stands alone."]
    return "\n".join(out) + "\n"


def suggest(token, candidates):
    token_l = token.lower()
    for c in candidates:
        if token_l == c.lower() or token_l in c.lower() or c.lower() in token_l:
            return c
    best, best_score = None, 0
    for c in candidates:
        score = len(set(token_l) & set(c.lower()))
        if score > best_score:
            best, best_score = c, score
    return best if best_score >= max(2, len(token) // 2) else None


def main(argv):
    if len(argv) == 0 or argv[0] in ("-h", "--help", "help"):
        sys.stdout.write(top_help())
        log(argv, "help:top", 0)
        return 0

    verb = argv[0]
    if verb not in COMMANDS:
        s = suggest(verb, list(COMMANDS.keys()))
        hint = f"\n\nDid you mean `moose {s}`?" if s else ""
        sys.stderr.write(f"error: unknown command '{verb}'{hint}\n")
        sys.stderr.write("Run `moose --help` to see all verbs.\n")
        log(argv, "error:unknown", 2)
        return 2

    rest = argv[1:]
    if rest and rest[0] in ("-h", "--help"):
        cap, desc, _out, sig = COMMANDS[verb]
        sys.stdout.write(f"Usage: moose {sig}\n\n{desc}\n")
        log(argv, f"help:verb:{verb}", 0)
        return 0

    cap, _desc, out_tmpl, _sig = COMMANDS[verb]
    if cap == "init" and rest and not rest[0].startswith("-"):
        name = rest[0]
        os.makedirs(name, exist_ok=True)
        with open(os.path.join(name, "moose.config.toml"), "w") as f:
            f.write(f'name = "{name}"\n')
        sys.stdout.write(out_tmpl.format(name=name) + "\n")
    elif cap == "harness:init" and rest and not rest[0].startswith("-"):
        name = rest[0]
        os.makedirs(name, exist_ok=True)
        with open(os.path.join(name, "moose.config.toml"), "w") as f:
            f.write(f'name = "{name}"\n')
        sys.stdout.write(out_tmpl + "\n")
    else:
        sys.stdout.write(out_tmpl + "\n")
    log(argv, f"matched:{cap}", 0)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
