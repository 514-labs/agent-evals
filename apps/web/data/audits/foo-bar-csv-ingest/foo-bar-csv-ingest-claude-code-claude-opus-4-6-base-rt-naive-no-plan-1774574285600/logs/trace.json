      "input": {
        "command": "python3 <<'PYEOF'\nimport csv\nimport io\nfrom datetime import datetime\n\nrows = []\n\nfor fname in [f\"/data/csv/events_0{i}.csv\" for i in range(1, 6)]:\n    with open(fname, \"r\") as f:\n        text = f.read()\n\n    # Fix trailing commas (events_05): strip trailing comma from each line\n    lines = []\n    for line in text.splitlines():\n        lines.append(line.rstrip(\",\"))\n    cleaned = \"\\n\".join(lines)\n\n    reader = csv.DictReader(io.StringIO(cleaned))\n    for row in reader:\n        # Skip duplicate header rows (events_04)\n        if row[\"event_id\"] == \"event_id\":\n            continue\n\n        # Normalize dates (events_02: DD/MM/YYYY)\n        ts_raw = row[\"event_ts\"].strip()\n        try:\n            dt = datetime.fromisoformat(ts_raw.replace(\"Z\", \"+00:00\"))\n        except ValueError:\n            dt = datetime.strptime(ts_raw, \"%d/%m/%Y\")\n        ts_str = dt.strftime(\"%Y-%m-%d %H:%M:%S\")\n\n        # Normalize value (events_03: N/A, null, empty -> NULL)\n        val_raw = row[\"value\"].strip() if row[\"value\"] else \"\"\n        if val_raw.lower() in (\"\", \"n/a\", \"null\", \"none\"):\n            val = \"\\\\N\"\n        else:\n            val = val_raw\n\n        rows.append(f\"{row['event_id']}\\t{ts_str}\\t{row['user_id']}\\t{row['event_type']}\\t{val}\")\n\n# Write TSV for bulk insert\nwith open(\"/tmp/events_clean.tsv\", \"w\") as f:\n    f.write(\"\\n\".join(rows) + \"\\n\")\n\nprint(f\"Prepared {len(rows)} clean rows\")\nPYEOF",
