{"type":"item.completed","item":{"id":"item_71","type":"command_execution","command":"/bin/bash -lc \"nl -ba /workspace/server.js | sed -n '1,220p'\"","aggregated_output":"     1\tconst http = require(\"http\");\n     2\tconst { createRequire } = require(\"module\");\n     3\t\n     4\tconst requireFromWorkspace = createRequire(__filename);\n     5\tconst requireFromEvalCore = createRequire(\"/opt/dec-bench/eval-core/package.json\");\n     6\t\n     7\tfunction loadClickHouseClient() {\n     8\t  try {\n     9\t    return requireFromWorkspace(\"@clickhouse/client\");\n    10\t  } catch (error) {\n    11\t    return requireFromEvalCore(\"@clickhouse/client\");\n    12\t  }\n    13\t}\n    14\t\n    15\tconst { createClient } = loadClickHouseClient();\n    16\t\n    17\tconst clickhouseUrl = process.env.CLICKHOUSE_URL;\n    18\t\n    19\tif (!clickhouseUrl) {\n    20\t  throw new Error(\"Missing CLICKHOUSE_URL environment variable.\");\n    21\t}\n    22\t\n    23\tconst client = createClient({ url: clickhouseUrl });\n    24\t\n    25\tconst METRICS_CACHE_TTL_MS = Number(process.env.METRICS_CACHE_TTL_MS ?? 250);\n    26\t\n    27\tlet cachedMetrics = null;\n    28\tlet cacheExpiresAt = 0;\n    29\tlet inFlightRefresh = null;\n    30\t\n    31\tfunction sendJson(res, statusCode, payload) {\n    32\t  res.writeHead(statusCode, { \"Content-Type\": \"application/json\" });\n    33\t  res.end(JSON.stringify(payload));\n    34\t}\n    35\t\n    36\tasync function queryMetricsTotal() {\n    37\t  const resultSet = await client.query({\n    38\t    query: \"SELECT sum(value) AS total FROM analytics.metrics\",\n    39\t    format: \"JSONEachRow\",\n    40\t  });\n    41\t  const rows = await resultSet.json();\n    42\t  const total = Number(rows[0]?.total ?? 0);\n    43\t  return { total };\n    44\t}\n    45\t\n    46\tasync function getMetrics() {\n    47\t  const now = Date.now();\n    48\t  if (cachedMetrics && now < cacheExpiresAt) {\n    49\t    return cachedMetrics;\n    50\t  }\n    51\t\n    52\t  if (inFlightRefresh) {\n    53\t    return inFlightRefresh;\n    54\t  }\n    55\t\n    56\t  inFlightRefresh = queryMetricsTotal()\n    57\t    .then((metrics) => {\n    58\t      cachedMetrics = metrics;\n    59\t      cacheExpiresAt = Date.now() + METRICS_CACHE_TTL_MS;\n    60\t      return metrics;\n    61\t    })\n    62\t    .finally(() => {\n    63\t      inFlightRefresh = null;\n    64\t    });\n    65\t\n    66\t  return inFlightRefresh;\n    67\t}\n    68\t\n    69\tconst server = http.createServer(async (req, res) => {\n    70\t  if (req.url !== \"/api/metrics\") {\n    71\t    sendJson(res, 404, { error: \"Not found\" });\n    72\t    return;\n    73\t  }\n    74\t\n    75\t  try {\n    76\t    const metrics = await getMetrics();\n    77\t    sendJson(res, 200, metrics);\n    78\t  } catch (error) {\n    79\t    sendJson(res, 500, {\n    80\t      error: error instanceof Error ? error.message : String(error),\n    81\t    });\n    82\t  }\n    83\t});\n    84\t\n    85\tserver.listen(3000, () => {\n    86\t  console.log(\"API on :3000\");\n    87\t});\n","exit_code":0,"status":"completed"}}
