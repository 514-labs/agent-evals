{"type":"item.completed","item":{"id":"item_53","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /workspace/server.js\"","aggregated_output":"const http = require(\"http\");\nconst { createClient } = require(\"@clickhouse/client\");\n\nconst clickhouseUrl = process.env.CLICKHOUSE_URL;\n\nif (!clickhouseUrl) {\n  throw new Error(\"Missing CLICKHOUSE_URL environment variable.\");\n}\n\nconst client = createClient({ url: clickhouseUrl });\n\nconst METRICS_CACHE_TTL_MS = Number(process.env.METRICS_CACHE_TTL_MS ?? 250);\n\nlet cachedMetrics = null;\nlet cacheExpiresAt = 0;\nlet inFlightRefresh = null;\n\nfunction sendJson(res, statusCode, payload) {\n  res.writeHead(statusCode, { \"Content-Type\": \"application/json\" });\n  res.end(JSON.stringify(payload));\n}\n\nasync function queryMetricsTotal() {\n  const resultSet = await client.query({\n    query: \"SELECT sum(value) AS total FROM analytics.metrics\",\n    format: \"JSONEachRow\",\n  });\n  const rows = await resultSet.json();\n  const total = Number(rows[0]?.total ?? 0);\n  return { total };\n}\n\nasync function getMetrics() {\n  const now = Date.now();\n  if (cachedMetrics && now < cacheExpiresAt) {\n    return cachedMetrics;\n  }\n\n  if (inFlightRefresh) {\n    return inFlightRefresh;\n  }\n\n  inFlightRefresh = queryMetricsTotal()\n    .then((metrics) => {\n      cachedMetrics = metrics;\n      cacheExpiresAt = Date.now() + METRICS_CACHE_TTL_MS;\n      return metrics;\n    })\n    .finally(() => {\n      inFlightRefresh = null;\n    });\n\n  return inFlightRefresh;\n}\n\nconst server = http.createServer(async (req, res) => {\n  if (req.url !== \"/api/metrics\") {\n    sendJson(res, 404, { error: \"Not found\" });\n    return;\n  }\n\n  try {\n    const metrics = await getMetrics();\n    sendJson(res, 200, metrics);\n  } catch (error) {\n    sendJson(res, 500, {\n      error: error instanceof Error ? error.message : String(error),\n    });\n  }\n});\n\nserver.listen(3000, () => {\n  console.log(\"API on :3000\");\n});\n","exit_code":0,"status":"completed"}}
