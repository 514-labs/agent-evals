{"type":"item.completed","item":{"id":"item_49","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /scenario/init/clickhouse-setup.sql\"","aggregated_output":"CREATE DATABASE IF NOT EXISTS analytics;\n\nCREATE TABLE analytics.events (\n  event_ts DateTime,\n  user_id String,\n  event_type String,\n  value Float64\n) ENGINE = MergeTree()\nORDER BY (event_ts, user_id);\n\nINSERT INTO analytics.events (event_ts, user_id, event_type, value) VALUES\n  ('2026-01-15 10:00:00', 'u1', 'pageview', 0),\n  ('2026-01-15 11:00:00', 'u2', 'pageview', 0),\n  ('2026-01-15 12:00:00', 'u1', 'purchase', 29.99),\n  ('2026-01-16 09:00:00', 'u1', 'pageview', 0),\n  ('2026-01-16 10:00:00', 'u3', 'purchase', 49.99);\n\nCREATE TABLE analytics.daily_metrics (\n  day Date,\n  dau UInt64,\n  revenue Float64\n) ENGINE = SummingMergeTree()\nORDER BY day;\n\nINSERT INTO analytics.daily_metrics\nSELECT\n  toDate(event_ts) AS day,\n  uniqExact(user_id) AS dau,\n  sum(value) AS revenue\nFROM analytics.events\nGROUP BY day;\n","exit_code":0,"status":"completed"}}
