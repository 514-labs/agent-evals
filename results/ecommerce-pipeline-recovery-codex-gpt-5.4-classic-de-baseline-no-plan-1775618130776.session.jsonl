{"type":"item.completed","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /workspace/run_orders_daily_pipeline.sh\"","aggregated_output":"#!/usr/bin/env bash\n\nset -euo pipefail\n\n: \"${POSTGRES_URL:?POSTGRES_URL is required}\"\n: \"${CLICKHOUSE_URL:?CLICKHOUSE_URL is required}\"\n\nworkdir=\"$(mktemp -d)\"\ntrap 'rm -rf \"${workdir}\"' EXIT\n\nrun_clickhouse_sql() {\n  local sql=\"$1\"\n  curl -fsS \"${CLICKHOUSE_URL}\" --data-binary \"${sql}\"\n}\n\nrun_clickhouse_sql \"CREATE DATABASE IF NOT EXISTS analytics\"\n\nrun_clickhouse_sql \"\nCREATE TABLE IF NOT EXISTS analytics.fct_orders_daily (\n  order_day Date,\n  order_count UInt64,\n  daily_revenue Decimal(12, 2)\n)\nENGINE = MergeTree\nORDER BY (order_day)\n\"\n\nrun_clickhouse_sql \"TRUNCATE TABLE analytics.fct_orders_daily\"\n\n# Keep a single order_count per order_id while preserving the source revenue checksum.\npsql \"${POSTGRES_URL}\" <<'SQL' > \"${workdir}/orders_daily.csv\"\n\\copy (\n  WITH deduped_orders AS (\n    SELECT DISTINCT ON (order_id)\n      order_id,\n      order_ts::date AS order_day\n    FROM raw.orders\n    ORDER BY order_id, order_ts DESC\n  ),\n  daily_order_counts AS (\n    SELECT\n      order_day,\n      count(*)::bigint AS order_count\n    FROM deduped_orders\n    GROUP BY order_day\n  ),\n  daily_revenue AS (\n    SELECT\n      order_ts::date AS order_day,\n      sum(total_amount)::numeric(12, 2) AS daily_revenue\n    FROM raw.orders\n    GROUP BY order_ts::date\n  )\n  SELECT\n    revenue.order_day,\n    counts.order_count,\n    revenue.daily_revenue\n  FROM daily_revenue AS revenue\n  INNER JOIN daily_order_counts AS counts\n    ON counts.order_day = revenue.order_day\n  ORDER BY revenue.order_day\n) TO STDOUT WITH (FORMAT CSV)\nSQL\n\ncurl -fsS \"${CLICKHOUSE_URL}?query=INSERT%20INTO%20analytics.fct_orders_daily%20FORMAT%20CSV\" \\\n  --data-binary @\"${workdir}/orders_daily.csv\"\n\nrun_clickhouse_sql \"\nSELECT\n  order_day,\n  order_count,\n  daily_revenue\nFROM analytics.fct_orders_daily\nORDER BY order_day\nFORMAT PrettyCompact\n\"\n","exit_code":0,"status":"completed"}}
