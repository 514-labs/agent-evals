{"type":"item.completed","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /workspace/backfill_metric_daily.sh\"","aggregated_output":"#!/usr/bin/env bash\nset -euo pipefail\n\n: \"${POSTGRES_URL:?POSTGRES_URL must be set}\"\n: \"${CLICKHOUSE_URL:?CLICKHOUSE_URL must be set}\"\n\ntmp_data_file=\"$(mktemp \"${TMPDIR:-/tmp}/metric-daily.XXXXXX.tsv\")\"\ntrap 'rm -f \"${tmp_data_file}\"' EXIT\n\npsql \"${POSTGRES_URL}\" \\\n  --no-align \\\n  --tuples-only \\\n  --field-separator=$'\\t' \\\n  --command \"\n    SELECT\n      date_trunc('day', event_ts)::date AS day,\n      count(DISTINCT user_id) AS user_count,\n      coalesce(sum(value), 0)::numeric(10,2) AS total_value\n    FROM raw.events\n    GROUP BY 1\n    ORDER BY 1;\n  \" > \"${tmp_data_file}\"\n\nclickhouse-client --query \"TRUNCATE TABLE analytics.metric_daily\"\n\nif [[ -s \"${tmp_data_file}\" ]]; then\n  clickhouse-client \\\n    --query \"INSERT INTO analytics.metric_daily (day, user_count, total_value) FORMAT TabSeparated\" \\\n    < \"${tmp_data_file}\"\nfi\n\nsource_total=\"$(\n  psql \"${POSTGRES_URL}\" \\\n    --no-align \\\n    --tuples-only \\\n    --command \"SELECT coalesce(sum(value), 0) FROM raw.events\"\n)\"\n\ntarget_total=\"$(\n  clickhouse-client \\\n    --query \"SELECT coalesce(sum(total_value), 0) FROM analytics.metric_daily FORMAT TSVRaw\"\n)\"\n\nsource_day_count=\"$(\n  psql \"${POSTGRES_URL}\" \\\n    --no-align \\\n    --tuples-only \\\n    --command \"SELECT count(DISTINCT date_trunc('day', event_ts)::date) FROM raw.events\"\n)\"\n\ntarget_day_count=\"$(\n  clickhouse-client \\\n    --query \"SELECT count() FROM analytics.metric_daily FORMAT TSVRaw\"\n)\"\n\nif [[ \"${source_total}\" != \"${target_total}\" ]]; then\n  echo \"backfill verification failed: Postgres total ${source_total}, ClickHouse total ${target_total}\" >&2\n  exit 1\nfi\n\nif [[ \"${source_day_count}\" != \"${target_day_count}\" ]]; then\n  echo \"backfill verification failed: Postgres days ${source_day_count}, ClickHouse rows ${target_day_count}\" >&2\n  exit 1\nfi\n\necho \"metric_daily backfill completed successfully\"\n","exit_code":0,"status":"completed"}}
