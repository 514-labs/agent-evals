{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /workspace/server.py\"","aggregated_output":"import http.server\nimport json\nimport os\nimport urllib.error\nimport urllib.request\n\n\nCLICKHOUSE_URL = os.environ[\"CLICKHOUSE_URL\"]\n\n\ndef run_clickhouse(query):\n    request = urllib.request.Request(CLICKHOUSE_URL, data=query.encode(), method=\"POST\")\n    with urllib.request.urlopen(request, timeout=30) as response:\n        return response.read().decode()\n\n\ndef execute_clickhouse(query):\n    try:\n        run_clickhouse(query)\n    except urllib.error.HTTPError as error:\n        body = error.read().decode(errors=\"replace\")\n        raise RuntimeError(f\"ClickHouse query failed: {body}\") from error\n\n\ndef ensure_aggregates():\n    execute_clickhouse(\n        \"\"\"\n        CREATE TABLE IF NOT EXISTS analytics.metrics_daily (\n            day Date,\n            total_events SimpleAggregateFunction(sum, UInt64),\n            unique_users AggregateFunction(uniqExact, String),\n            total_revenue SimpleAggregateFunction(sum, Float64)\n        )\n        ENGINE = AggregatingMergeTree()\n        ORDER BY day\n        \"\"\"\n    )\n    execute_clickhouse(\n        \"\"\"\n        CREATE TABLE IF NOT EXISTS analytics.breakdown_by_region_day (\n            region LowCardinality(String),\n            day Date,\n            event_count UInt64\n        )\n        ENGINE = SummingMergeTree()\n        ORDER BY (region, day)\n        \"\"\"\n    )\n\n    metrics_rows = int(run_clickhouse(\"SELECT count() FROM analytics.metrics_daily\").strip() or \"0\")\n    if metrics_rows == 0:\n        execute_clickhouse(\n            \"\"\"\n            INSERT INTO analytics.metrics_daily\n            SELECT\n                toDate(event_ts) AS day,\n                count() AS total_events,\n                uniqExactState(user_id) AS unique_users,\n                sum(revenue) AS total_revenue\n            FROM analytics.events\n            GROUP BY day\n            \"\"\"\n        )\n\n    breakdown_rows = int(run_clickhouse(\"SELECT count() FROM analytics.breakdown_by_region_day\").strip() or \"0\")\n    if breakdown_rows == 0:\n        execute_clickhouse(\n            \"\"\"\n            INSERT INTO analytics.breakdown_by_region_day\n            SELECT\n                region,\n                toDate(event_ts) AS day,\n                count() AS event_count\n            FROM analytics.events\n            GROUP BY region, day\n            \"\"\"\n        )\n\n    execute_clickhouse(\n        \"\"\"\n        CREATE MATERIALIZED VIEW IF NOT EXISTS analytics.metrics_daily_mv\n        TO analytics.metrics_daily\n        AS\n        SELECT\n            toDate(event_ts) AS day,\n            count() AS total_events,\n            uniqExactState(user_id) AS unique_users,\n            sum(revenue) AS total_revenue\n        FROM analytics.events\n        GROUP BY day\n        \"\"\"\n    )\n    execute_clickhouse(\n        \"\"\"\n        CREATE MATERIALIZED VIEW IF NOT EXISTS analytics.breakdown_by_region_day_mv\n        TO analytics.breakdown_by_region_day\n        AS\n        SELECT\n            region,\n            toDate(event_ts) AS day,\n            count() AS event_count\n        FROM analytics.events\n        GROUP BY region, day\n        \"\"\"\n    )\n\n\nclass Handler(http.server.BaseHTTPRequestHandler):\n    def _write_json(self, payload):\n        encoded = json.dumps(payload).encode()\n        self.send_response(200)\n        self.send_header(\"Content-Type\", \"application/json\")\n        self.send_header(\"Content-Length\", str(len(encoded)))\n        self.end_headers()\n        self.wfile.write(encoded)\n\n    def do_GET(self):\n        if self.path == \"/api/metrics\":\n            out = run_clickhouse(\n                \"\"\"\n                SELECT\n                    sum(total_events) AS total,\n                    uniqExactMerge(unique_users) AS users,\n                    sum(total_revenue) AS revenue\n                FROM analytics.metrics_daily\n                FORMAT JSONEachRow\n                \"\"\"\n            )\n            rows = [json.loads(line) for line in out.strip().splitlines() if line]\n            data = rows[0] if rows else {}\n            self._write_json(\n                {\n                    \"total_events\": data.get(\"total\"),\n                    \"unique_users\": data.get(\"users\"),\n                    \"total_revenue\": data.get(\"revenue\"),\n                }\n            )\n            return\n\n        if self.path == \"/api/breakdown\":\n            out = run_clickhouse(\n                \"\"\"\n                SELECT\n                    region,\n                    day,\n                    sum(event_count) AS cnt\n                FROM analytics.breakdown_by_region_day\n                GROUP BY region, day\n                ORDER BY region, day\n                FORMAT JSONEachRow\n                \"\"\"\n            )\n            rows = [json.loads(line) for line in out.strip().splitlines() if line]\n            self._write_json(rows)\n            return\n\n        self.send_response(404)\n        self.end_headers()\n\n\ndef main():\n    ensure_aggregates()\n    http.server.ThreadingHTTPServer((\"0.0.0.0\", 3000), Handler).serve_forever()\n\n\nif __name__ == \"__main__\":\n    main()\n","exit_code":0,"status":"completed"}}
