FfcLxnD9BsR98R/N8oihvOrXFjqfAOPYKl3maWZhk9u6lGWO+rgUSYUBZebN\\nzl8gXrRPPKB/iphcVudQQzUTwC33V9zhkcCo5IkiGJxJpwULpXoZPTzJlHRH\\n6994RERnS91F5zW0eR61HQxTh2685RlHmn0Dkp8kvVpMUFQnKGIdpxKvtqx0\\nRZLP/w1fQVG2cMOw7apW2Yfw50hM/GVMY+W25vwPqXTNUAwLUUTTt28/d94g\\nnAei\\r\\n=XlsF\\r\\n-----END PGP SIGNATURE-----\\r\\n\"},\"main\":\"fsevents.js\",\"readme\":\"# fsevents [![NPM](https://nodei.co/npm/fsevents.png)](https://nodei.co/npm/fsevents/)\\n\\nNative access to MacOS FSEvents in [Node.js](https://nodejs.org/)\\n\\nThe FSEvents API in MacOS allows applications to register for notifications of\\nchanges to a given directory tree. It is a very fast and lightweight alternative\\nto kqueue.\\n\\nThis is a low-level library. For a cross-platform file watching module that\\nuses fsevents, check out [Chokidar](https://github.com/paulmillr/chokidar).\\n\\n## Installation\\n\\n```sh\\nnpm install fsevents\\n```\\n\\n## Usage\\n\\n```js\\nconst fsevents = require('fsevents');\\nconst stop = fsevents.watch(__dirname, (path, flags, id) => {\\n  const info = fsevents.getInfo(path, flags, id);\\n}); // To start observation\\nstop(); // To end observation\\n```\\n\\nThe callback passed as the second parameter to `.watch` get's called whenever the operating system detects a\\na change in the file system. It takes three arguments:\\n\\n`(path: String, flags: Number, id: String) => {}`\\n\\n * `path` - the item in the filesystem that have been changed\\n * `flags` - a numeric value describing what the change was\\n * `id` - an unique-id identifying this specific event\\n\\n###### `fsevents.getInfo(path, flags, id): FsEventInfo => {}`\\n\\nThe `getInfo` function takes the `path`, `flags` and `id` arguments and converts those parameters into a structure\\nthat is easier to digest to determine what the change was.\\n\\nThe `FsEventsInfo` has the following shape:\\n\\n```js\\n/**\\n * @typedef {'created'|'modified'|'deleted'|'moved'|'root-changed'|'unknown'} FsEventsEvent\\n * @typedef {'file'|'directory'|'symlink'} FsEventsType\\n */\\n{\\n  \\\"event\\\": \\\"created\\\",\\n  \\\"path\\\": \\\"file.txt\\\", // {FsEventsEvent}\\n  \\\"type\\\": \\\"file\\\",    // {FsEventsType}\\n  \\\"changes\\\": {\\n    \\\"inode\\\": true,   // Had iNode Meta-Information changed\\n    \\\"finder\\\": false, // Had Finder Meta-Data changed\\n    \\\"access\\\": false, // Had access permissions changed\\n    \\\"xattrs\\\": false  // Had xAttributes changed\\n  },\\n  \\\"flags\\\": 0x100000000\\n}\\n```\\n\\n## License\\n\\nThe MIT License Copyright (C) 2010-2018 by Philipp Dunkel, Ben Noordhuis, Elan Shankar — see LICENSE file.\\n\\nVisit our [GitHub page](https://github.com/fsevents/fsevents) and [NPM Page](https://npmjs.org/package/fsevents)\\n\",\"engines\":{\"node\":\"^8.16.0 || ^10.6.0 || >=11.0.0\"},\"gitHead\":\"6e16b1a4589c422d98aa084fb450196cfefc2ed5\",\"scripts\":{\"test\":\"/bin/bash ./test.sh 2>/dev/null\",\"clean\":\"node-gyp clean && rm -f fsevents.node\",\"install\":\"[ -f fsevents.node ] || npm run prepublishOnly\",\"prepublishOnly\":\"node-gyp clean && rm -f fsevents.node && node-gyp rebuild && node-gyp clean\"},\"_npmUser\":{\"name\":\"pipobscure\",\"email\":\"pip@pipobscure.com\"},\"repository\":{\"url\":\"git+https://github.com/fsevents/fsevents.git\",\"type\":\"git\"},\"_npmVersion\":\"6.7.0\",\"description\":\"Native Access to Mac OS-X FSEvents\",\"directories\":{},\"_nodeVersion\":\"11.14.0\",\"_hasShrinkwrap\":false,\"readmeFilename\":\"README.md\",\"devDependencies\":{},\"_npmOperationalInternal\":{\"tmp\":\"tmp/fsevents_2.0.5_1555433424663_0.05713479282296485\",\"host\":\"s3://npm-registry-packages\"}},\"2.0.6\":{\"name\":\"fsevents\",\"version\":\"2.0.6\",\"keywords\":[\"fsevents\",\"mac\"],\"license\":\"MIT\",\"_id\":\"fsevents@2.0.6\",\"maintainers\":[{\"name\":\"bajtos\",\"email\":\"mbajtoss@gmail.com\"},{\"name\":\"bnoordhuis\",\"email\":\"info@bnoordhuis.nl\"},{\"name\":\"es128\",\"email\":\"elan.shanker+npm@gmail.com\"},{\"name\":\"paul