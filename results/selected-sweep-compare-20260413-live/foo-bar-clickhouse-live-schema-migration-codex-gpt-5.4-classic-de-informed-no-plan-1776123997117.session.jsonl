git\"},\"_npmVersion\":\"6.13.4\",\"description\":\"Native Access to MacOS FSEvents\",\"directories\":{},\"_nodeVersion\":\"12.16.1\",\"_hasShrinkwrap\":false,\"devDependencies\":{\"node-gyp\":\"^6.1.0\"},\"_npmOperationalInternal\":{\"tmp\":\"tmp/fsevents_2.1.3_1587545303123_0.40284197395726373\",\"host\":\"s3://npm-registry-packages\"}},\"1.2.13\":{\"name\":\"fsevents\",\"version\":\"1.2.13\",\"keywords\":[\"fsevents\",\"mac\"],\"author\":{\"name\":\"Philipp Dunkel\",\"email\":\"pip@pipobscure.com\"},\"license\":\"MIT\",\"_id\":\"fsevents@1.2.13\",\"maintainers\":[{\"name\":\"bnoordhuis\",\"email\":\"info@bnoordhuis.nl\"},{\"name\":\"es128\",\"email\":\"elan.shanker+npm@gmail.com\"},{\"name\":\"paulmillr\",\"email\":\"paul@paulmillr.com\"},{\"name\":\"pipobscure\",\"email\":\"pip@pipobscure.com\"}],\"homepage\":\"https://github.com/strongloop/fsevents\",\"bugs\":{\"url\":\"https://github.com/strongloop/fsevents/issues\"},\"os\":[\"darwin\"],\"dist\":{\"shasum\":\"f325cb0455592428bcf11b383370ef70e3bfcc38\",\"tarball\":\"https://registry.npmjs.org/fsevents/-/fsevents-1.2.13.tgz\",\"fileCount\":14,\"integrity\":\"sha512-oWb1Z6mkHIskLzEJ/XWX0srkpkTQ7vaopMQkyaEIoq0fmtFVxOthb8cCxeT+p3ynTdkk/RZwbgG4brR5BeWECw==\",\"signatures\":[{\"sig\":\"MEYCIQCjRs/SfO5y7I5Ps7D2g9RStAHoNNhWF6kPtQviZJVc3gIhAJZWFyxjyi03briQrTzfRac6sBdjPgL252Cr6ZNs8yMe\",\"keyid\":\"SHA256:jl3bwswu80PjjokCgh0o2w5c2U4LhQAE57gj9cz1kzA\"}],\"unpackedSize\":25750,\"npm-signature\":\"-----BEGIN PGP SIGNATURE-----\\r\\nVersion: OpenPGP.js v3.0.4\\r\\nComment: https://openpgpjs.org\\r\\n\\r\\nwsFcBAEBCAAQBQJesdVWCRA9TVsSAnZWagAANXEP/1qzErlMRWCM9Rsg1lUh\\ns989nuaZmfjaRemf59WeX8ifZazduUAqc6siECvhPknctwC/kra3Tl9dIKcl\\n8KQ7GT/qARupPzhTSkHecE7lASKQHos5AQf2hMZ+ysUelOlrZVwqNA936FA7\\nrRWO863SDlPE/rHGiUtEwBZxkojeQ6du0ETtVxteUGHBAuw+CnMxF6lBu/s7\\nUhP/MMZ6ApzeXHf5zED16Kd02twWeAoK/67AzzFyBZLkZ90wZL1E47+1fv44\\nRJNvWauSUE7kLgxBYpGdAvgxilkulPQ0Hpkx3V4B0ePr9rpOpeZVQeL+bz5l\\nA0CN6lMK9o8AJPamrg6zztO/B1tJqex4QJ6YyI0j0Ie0muwX4cfYG2nBaCpD\\nnfzmkgYQHqJHsNV2DtE+ScXOtczR3u/e7uKzrh5BTFUlw6HXzinlfuJjf2CS\\nUT9dD+uPdq0U46KkV+0U3336NkZdFc0NUbZnEATMWrRF6SWiUP3FPiGxnIBa\\n70gFftkX/wOKWzIPleu3B5klvcrauCMepK4Uw1fsG74veZF6VQ3isd3T6QSM\\nlPNjUjQLdTOAxRXcAwFkc7td4sFGe0dXo/mjmqAt5U6M5l8yyuWxSJOZRAh9\\nwVgP4EyzbAKqo3OrQi/huRRvd2pLOl3toitN+LBSNvimdwIpWgH+4c6eh4hq\\nEAGO\\r\\n=TC7m\\r\\n-----END PGP SIGNATURE-----\\r\\n\"},\"main\":\"fsevents.js\",\"readme\":\"# fsevents [![NPM](https://nodei.co/npm/fsevents.png)](https://nodei.co/npm/fsevents/)\\n\\nNative access to OS X FSEvents in [Node.js](http://nodejs.org/)\\n\\nThe FSEvents API in OS X allows applications to register for notifications of\\nchanges to a given directory tree. It is a very fast and lightweight alternative\\nto kqueue.\\n\\nThis is a low-level library. For a cross-compatible file watching module that\\nuses fsevents, check out [Chokidar](https://www.npmjs.com/package/chokidar).\\n\\n* [Module Site & GitHub](https://github.com/strongloop/fsevents)\\n* [NPM Page](https://npmjs.org/package/fsevents)\\n\\n## Installation\\n\\n\\t$ npm install fsevents\\n\\n## Usage\\n\\n```js\\nvar fsevents = require('fsevents');\\nvar watcher = fsevents(__dirname);\\nwatcher.on('fsevent', function(path, flags, id) { }); // RAW Event as emitted by OS-X\\nwatcher.on('change', function(path, info) { }); // Common Event for all changes\\nwatcher.start() // To start observation\\nwatcher.stop()  // To end observation\\n```\\n\\n### Events\\n\\n * *fsevent* - RAW Event as emitted by OS-X\\n * *change* - Common Event for all changes\\n * *created* - A File-System-Item has been created\\n * *deleted* - A File-System-Item has been deleted\\n * *modified* - A File-System-Item has been modified\\n * *moved-out* - A File-System-Item has been moved away from this location\\n * *moved-in* - A File-System-Item has been moved into this location\\n\\nAll events except *fsevent* take an *info* object as the second parameter of the callback. The structure of this object is:\\n\\n```js\\n{\\n  \\\"event\\\": \\\"<event-type>\\\",\\n  \\\"id\\\": <eventi-id>,\\n  \\\"path\\\": \\\"<path-that-this-is-about>\\\",\\n  \\\"type\\\": \\\"<file|directory|symlink>\\\",\\n  \\\"changes\\\": {\\n    \\\"inode\\\": true, // Has the iNode Meta-Information changed\\n    \\\"finder\\\": false, // Has the Finder Meta-Data changed\\n    \\\"access\\\": false, // Have the access permissions changed\\n    \\\"xattrs\\\": false // Have the xAttributes changed\\n  },\\n  \\\"flags\\\": <raw-flags>\\n}\\n```\\n\\n## MIT License\\n\\nCopyright (C) 2010-2014 Philipp Dunkel\\n\\nPermission is hereby granted, free of charge, to any person obtaining a copy\\nof this software and associated documentation files (the \\\"Software\\\"), to deal\\nin the Software without restriction, including without limitation the rights\\nto use, copy, modify, merge, publish, distribute, sublicense, and/or sell\\ncopies of the Software, and to permit persons to whom the Software is\\nfurnished to do so, subject to the following conditions:\\n\\nThe above copyright notice and this permission notice shall be included in\\nall copies or substantial portions of the Software.\\n\\nTHE SOFTWARE IS PROVIDED \\\"AS IS\\\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\\nIMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\\nFITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\\nAUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\\nLIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\\nOUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN\\nTHE SOFTWARE.\\n\",\"engines\":{\"node\":\">= 4.0\"},\"gitHead\":\"844a05d41fa0f764c7457dae266b0ab50384394a\",\"scripts\":{\"test\":\"node ./test/fsevents.js && node ./test/function.js 2> /dev/null\",\"install\":\"node install.js\"},\"_npmUser\":{\"name\":\"pipobscure\",\"email\":\"pip@pipobscure.com\"},\"repository\":{\"url\":\"git+https://github.com/strongloop/fsevents.git\",\"type\":\"git\"},\"_npmVersion\":\"6.4.1\",\"description\":\"Native Access to Mac OS-X FSEvents\",\"directories\":{},\"_nodeVersion\":\"10.15.1\",\"dependencies\":{\"nan\":\"^2.12.1\",\"bindings\":\"^1.5.0\"},\"_hasShrinkwrap\":false,\"readmeFilename\":\"Readme.md\",\"_npmOperationalInternal\":{\"tmp\":\"tmp/fsevents_1.2.13_1588712790211_0.34870418787981894\",\"host\":\"s3://npm-registry-packages\"},\"deprecated\":\"Upgrade to fsevents v2 to mitigate potential security issues\"},\"2.2.0\":{\"name\":\"fsevents\",\"version\":\"2.2.0\",\"keywords\":[\"fsevents\",\"mac\"],\"license\":\"MIT\",\"_id\":\"fsevents@2.2.0\",\"maintainers\":[{\"name\":\"pipobscure\",\"email\":\"pip@pipobscure.com\"},{\"name\":\"paulmillr\",\"email\":\"paul@paulmillr.com\"}],\"contributors\":[{\"name\":\"Philipp Dunkel\",\"email\":\"pip@pipobscure.com\"},{\"name\":\"Ben Noordhuis\",\"email\":\"info@bnoordhuis.nl\"},{\"name\":\"Elan Shankar\",\"email\":\"elan.shanker@gmail.com\"},{\"name\":\"Miroslav Bajtoš\",\"email\":\"mbajtoss@gmail.com\"},{\"url\":\"https://paulmillr.com\",\"name\":\"Paul Miller\"}],\"homepage\":\"https://github.com/fsevents/fsevents\",\"bugs\":{\"url\":\"https://github.com/fsevents/fsevents/issues\"},\"os\":[\"darwin\"],\"dist\":{\"shasum\":\"4150396a427ecb5baa747725b70270a72b17bc17\",\"tarball\":\"https://registry.npmjs.org/fsevents/-/fsevents-2.2.0.tgz\",\"fileCount\":6,\"integrity\":\"sha512-pKnaUh2TNvk+/egJdBw1h46LwyLx8BzEq+MGCf/RMCVfEHHsGOCWG00dqk91kUPPArIIwMBg9T/virxwzP03cA==\",\"signatures\":[{\"sig\":\"MEQCICZttO23svPea2Sy2LZ/sqkVG6+2KN/DvAM/SJzlkt5cAiBrK/UAfYd12tdQssTa5P/+EJmHaoWIZLInLT+omsYoAQ==\",\"keyid\":\"SHA256:jl3bwswu80PjjokCgh0o2w5c2U4LhQAE57gj9cz1kzA\"}],\"unpackedSize\":75099,\"npm-signature\":\"-----BEGIN PGP SIGNATURE-----\\r\\nVersion: OpenPGP.js v3.0.13\\r\\nComment: https://openpgpjs.org\\r\\n\\r\\nwsFcBAEBCAAQBQJfoVPsCRA9TVsSAnZWagAABgsP/Rabj9Eudr56xU0wOBnJ\\nQE+tBcZtL1or28KhtbeKMKqzfmpVk5ypw3F1jZjWfbNST9cbLdQ0Wdy/m/B2\\nF7bEfOSGFcXKOjGf8qUyAbtaSK/OCxDOLBwA8Qjb8ROYnLR2/UNE31raG0C3\\nuqgCeCtKgS5w8hDHmPeYDOMUUMpBQiAXFFq70RqCdx9st4FFjY2PMOnUYsTu\\nwVlpXI3v3ZLoEe2fzV3hejjBJf1oFwx2NsmKDy22Uc81ERNYk3kBGTncBQDg\\nP/Q9N7sue4tnBd60YgUiVBUrY0v2VQ0XXu7dKSRM5nftht8NPfgenHlHxYAS\\nNg2GE40FqAkiyXpTaOQ5SutgT4GuPqIQczdS6/6/ZX5CyQfc5EIdVKmfAa/3\\nurj42Dq1NXAWbtU48th+y9macy/47mXvycvJaC8uxEzWN4Y652hfaKVRSESW\\njA+07AqmXBgGdngbov+2RIhKzA9ek3CtIi+wQu5pW1iSjRCNFtPokzQURnh1\\nFm3my2oGtPq9mQaPKSIxPhVeWsXHt75pPC0Ee4XVwMQVLs5G6+Z1DXL5rER0\\nfe+Qbaii+KAUXpeOhWOzwLDCJxkMRYL/CJ9fC2RHw0fDSnp4SVTuqj+yyjbH\\nkluGZrb0Y8xdTWka3elRe4RSLBkvOXuzOTOzTy0LTQsLOApO/quuP6ivrAf5\\nQkaW\\r\\n=wdbi\\r\\n-----END PGP SIGNATURE-----\\r\\n\"},\"main\":\"fsevents.js\",\"types\":\"fsevents.d.ts\",\"readme\":\"# fsevents [![NPM](https://nodei.co/npm/fsevents.png)](https://nodei.co/npm/fsevents/)\\n\\nNative access to MacOS FSEvents in [Node.js](https://nodejs.org/)\\n\\nThe FSEvents API in MacOS allows applications to register for notifications of\\nchanges to a given directory tree. It is a very fast and lightweight alternative\\nto kqueue.\\n\\nThis is a low-level library. For a cross-platform file watching module that\\nuses fsevents, check out [Chokidar](https://github.com/paulmillr/chokidar).\\n\\n## Installation\\n\\nSupports only **Node.js v8.16 and higher**.\\n\\n```sh\\nnpm install fsevents\\n```\\n\\n## Usage\\n\\n```js\\nconst fsevents = require('fsevents');\\nconst stop = fsevents.watch(__dirname, (path, flags, id) => {\\n  const info = fsevents.getInfo(path, flags, id);\\n}); // To start observation\\nstop(); // To end observation\\n```\\n\\nThe callback passed as the second parameter to `.watch` get's called whenever the operating system detects a\\na change in the file system. It takes three arguments:\\n\\n###### `fsevents.watch(dirname: string, (path: string, flags: number, id: string) => void): () => Promise<undefined>`\\n\\n * `path: string` - the item in the filesystem that have been changed\\n * `flags: number` - a numeric value describing what the change was\\n * `id: string` - an unique-id identifying this specific event\\n\\n Returns closer callback which when called returns a Promise resolving when the watcher process has been shut down.\\n\\n###### `fsevents.getInfo(path: string, flags: number, id: string): FsEventInfo`\\n\\nThe `getInfo` function takes the `path`, `flags` and `id` arguments and converts those parameters into a structure\\nthat is easier to digest to determine what the change was.\\n\\nThe `FsEventsInfo` has the following shape:\\n\\n```js\\n/**\\n * @typedef {'created'|'modified'|'deleted'|'moved'|'root-changed'|'cloned'|'unknown'} FsEventsEvent\\n * @typedef {'file'|'directory'|'symlink'} FsEventsType\\n */\\n{\\n  \\\"event\\\": \\\"created\\\", // {FsEventsEvent}\\n  \\\"path\\\": \\\"file.txt\\\", \\n  \\\"type\\\": \\\"file\\\",    // {FsEventsType}\\n  \\\"changes\\\": {\\n    \\\"inode\\\": true,   // Had iNode Meta-Information changed\\n    \\\"finder\\\": false, // Had Finder Meta-Data changed\\n    \\\"access\\\": false, // Had access permissions changed\\n    \\\"xattrs\\\": false  // Had xAttributes changed\\n  },\\n  \\\"flags\\\": 0x100000000\\n}\\n```\\n\\n## Engine compatibility\\n\\n- v2 supports node 8.16+\\n- v1.2.8 supports node 6+\\n- v1.2.7 supports node 4+\\n\\n## Troubleshooting\\n\\n- I'm getting `EBADPLATFORM` `Unsupported platform for fsevents` error.\\n- It's fine, nothing is broken. fsevents is macos-only. Other platforms are skipped. If you want to hide this warning, report a bug to NPM bugtracker asking them to hide ebadplatform warnings by default.\\n\\n## License\\n\\nThe MIT License Copyright (C) 2010-2020 by Philipp Dunkel, Ben Noordhuis, Elan Shankar, Paul Miller — see LICENSE file.\\n\\nVisit our [GitHub page](https://github.com/fsevents/fsevents) and [NPM Page](https://npmjs.org/package/fsevents)\\n\",\"engines\":{\"node\":\"^8.16.0 || ^10.6.0 || >=11.0.0\"},\"gitHead\":\"6a3bb59898ae2da68bed80afdc2ab59583972168\",\"gypfile\":true,\"scripts\":{\"test\":\"/bin/bash ./test.sh 2>/dev/null\",\"build\":\"node-gyp clean && rm -f fsevents.node && node-gyp rebuild && node-gyp clean\",\"clean\":\"node-gyp clean && rm -f fsevents.node\",\"install\":\"node-gyp rebuild\",\"prepublishOnly\":\"npm run build\"},\"_npmUser\":{\"name\":\"pipobscure\",\"email\":\"pip@pipobscure.com\"},\"repository\":{\"url\":\"git+https://github.com/fsevents/fsevents.git\",\"type\":\"git\"},\"_npmVersion\":\"6.14.5\",\"description\":\"Native Access to MacOS FSEvents\",\"directories\":{},\"_nodeVersion\":\"14.5.0\",\"_hasShrinkwrap\":false,\"readmeFilename\":\"README.md\",\"devDependencies\":{\"node-gyp\":\"^6.1.0\"},\"_npmOperationalInternal\":{\"tmp\":\"tmp/fsevents_2.2.0_1604408299683_0.27155820439605205\",\"host\":\"s3://npm-registry-packages\"}},\"2.2.1\":{\"name\":\"fsevents\",\"version\":\"2.2.1\",\"keywords\":[\"fsevents\",\"mac\"],\"license\":\"MIT\",\"_id\":\"fsevents@2.2.1\",\"maintainers\":[{\"name\":\"pipobscure\",\"email\":\"pip@pipobscure.com\"},{\"name\":\"paulmillr\",\"email\":\"paul@paulmillr.com\"}],\"contributors\":[{\"name\":\"Philipp Dunkel\",\"email\":\"pip@pipobscure.com\"},{\"name\":\"Ben Noordhuis\",\"email\":\"info@bnoordhuis.nl\"},{\"name\":\"Elan Shankar\",\"email\":\"elan.shanker@gmail.com\"},{\"name\":\"Miroslav Bajtoš\",\"email\":\"mbajtoss@gmail.com\"},{\"url\":\"https://paulmillr.com\",\"name\":\"Paul Miller\"}],\"homepage\":\"https://github.com/fsevents/fsevents\",\"bugs\":{\"url\":\"https://github.com/fsevents/fsevents/issues\"},\"os\":[\"darwin\"],\"dist\":{\"shasum\":\"1fb02ded2036a8ac288d507a65962bd87b97628d\",\"tarball\":\"https://registry.npmjs.org/fsevents/-/fsevents-2.2.1.tgz\",\"fileCount\":6,\"integrity\":\"sha512-bTLYHSeC0UH/EFXS9KqWnXuOl/wHK5Z/d+ghd5AsFMYN7wIGkUCOJyzy88+wJKkZPGON8u4Z9f6U4FdgURE9qA==\",\"signatures\":[{\"sig\":\"MEUCIQC+D67o40ue7wq5mIDnsUHKNFSeceENxLgWSJvpO8FbjQIgUu7SjBGV3KKRunSwgXNIgi3pdScaAnbVM6bBy1Ls+PQ=\",\"keyid\":\"SHA256:jl3bwswu80PjjokCgh0