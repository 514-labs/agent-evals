{"type":"item.completed","item":{"id":"item_54","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /workspace/scripts/reconcile.py\"","aggregated_output":"#!/usr/bin/env python3\nimport argparse\nimport json\nimport os\nimport sys\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom urllib.parse import urlparse\n\nimport clickhouse_connect\nimport psycopg2\nfrom kafka import KafkaConsumer, TopicPartition\n\n\nWORKSPACE_ROOT = Path(\"/workspace\")\nCANONICAL_REPORT_PATH = WORKSPACE_ROOT / \"artifacts\" / \"drift-report.json\"\nTOPIC_NAME = \"transactions\"\n\n\ndef parse_args() -> argparse.Namespace:\n    parser = argparse.ArgumentParser(description=\"Reconcile transaction counts across Postgres, Redpanda, and ClickHouse.\")\n    parser.add_argument(\"--tolerance\", type=float, default=0.0, help=\"Maximum allowed absolute count drift from Postgres.\")\n    parser.add_argument(\"--report-path\", default=str(CANONICAL_REPORT_PATH), help=\"Optional additional path for a copy of the structured report.\")\n    return parser.parse_args()\n\n\ndef require_env(name: str) -> str:\n    value = os.getenv(name, \"\").strip()\n    if not value:\n        raise RuntimeError(f\"{name} is required.\")\n    return value\n\n\ndef fetch_pg_count(pg_url: str) -> int:\n    conn = psycopg2.connect(pg_url, connect_timeout=2)\n    try:\n        with conn.cursor() as cur:\n            cur.execute(\"SELECT count(*) FROM app.transactions\")\n            return int(cur.fetchone()[0])\n    finally:\n        conn.close()\n\n\ndef fetch_topic_count(broker: str) -> int:\n    consumer = KafkaConsumer(\n        bootstrap_servers=[broker],\n        enable_auto_commit=False,\n        consumer_timeout_ms=1200,\n        request_timeout_ms=2000,\n        api_version_auto_timeout_ms=1000,\n    )\n    try:\n        partitions = consumer.partitions_for_topic(TOPIC_NAME)\n        if not partitions:\n            return 0\n        topic_partitions = [TopicPartition(TOPIC_NAME, partition) for partition in sorted(partitions)]\n        offsets = consumer.end_offsets(topic_partitions)\n        return sum(int(offsets[partition]) for partition in topic_partitions)\n    finally:\n        consumer.close()\n\n\ndef fetch_ch_count(clickhouse_url: str) -> int:\n    parsed = urlparse(clickhouse_url)\n    host = parsed.hostname or \"localhost\"\n    port = parsed.port or 8123\n    client = clickhouse_connect.get_client(\n        host=host,\n        port=port,\n        username=parsed.username or \"default\",\n        password=parsed.password or \"\",\n        database=(parsed.path or \"/\").lstrip(\"/\") or \"default\",\n        connect_timeout=2,\n        send_receive_timeout=2,\n    )\n    try:\n        return int(client.query(\"SELECT count() FROM analytics.transactions\").first_item[\"count()\"])\n    finally:\n        client.close()\n\n\ndef build_report(tolerance: float, pg_count: int, topic_count: int, ch_count: int) -> dict:\n    comparisons = {\"redpanda\": topic_count, \"clickhouse\": ch_count}\n    behind_systems = [system for system, actual in comparisons.items() if actual < pg_count]\n    discrepancies = []\n    for system, actual in comparisons.items():\n        difference = actual - pg_count\n        if abs(difference) > tolerance:\n            discrepancies.append(\n                {\n                    \"system\": system,\n                    \"expected\": pg_count,\n                    \"actual\": actual,\n                    \"difference\": difference,\n                }\n            )\n    status = \"ok\" if not discrepancies else \"drift\"\n    if status == \"ok\":\n        summary = f\"Counts are within tolerance {tolerance}: postgres={pg_count}, redpanda={topic_count}, clickhouse={ch_count}.\"\n    else:\n        lagging = \", \".join(behind_systems) if behind_systems else \"none\"\n        summary = f\"Drift detected against Postgres: redpanda={topic_count}, clickhouse={ch_count}, postgres={pg_count}. Behind systems: {lagging}.\"\n    return {\n        \"status\": status,\n        \"generated_at\": datetime.now(timezone.utc).isoformat(),\n        \"tolerance\": tolerance,\n        \"pg_count\": pg_count,\n        \"topic_count\": topic_count,\n        \"ch_count\": ch_count,\n        \"behind_systems\": behind_systems,\n        \"discrepancies\": discrepancies,\n        \"summary\": summary,\n        \"report_path\": str(CANONICAL_REPORT_PATH),\n    }\n\n\ndef write_report(report: dict, custom_path: str) -> None:\n    CANONICAL_REPORT_PATH.parent.mkdir(parents=True, exist_ok=True)\n    canonical_json = json.dumps(report, indent=2, sort_keys=True)\n    CANONICAL_REPORT_PATH.write_text(canonical_json + \"\\n\", encoding=\"utf-8\")\n    requested_path = Path(custom_path)\n    if requested_path != CANONICAL_REPORT_PATH:\n        requested_path.parent.mkdir(parents=True, exist_ok=True)\n        requested_path.write_text(canonical_json + \"\\n\", encoding=\"utf-8\")\n\n\ndef operator_summary(report: dict, custom_path: str) -> str:\n    if report[\"status\"] == \"ok\":\n        return f\"Reconciliation OK. No systems are behind. Canonical report: {CANONICAL_REPORT_PATH}.\"\n    if report[\"behind_systems\"]:\n        behind = \", \".join(report[\"behind_systems\"])\n        return f\"Reconciliation DRIFT. Behind systems: {behind}. Canonical report: {CANONICAL_REPORT_PATH}. Requested report copy: {custom_path}.\"\n    return f\"Reconciliation DRIFT. No system is behind, but counts exceed tolerance. Canonical report: {CANONICAL_REPORT_PATH}. Requested report copy: {custom_path}.\"\n\n\ndef main() -> int:\n    args = parse_args()\n    try:\n        try:\n            pg_count = fetch_pg_count(require_env(\"POSTGRES_URL\"))\n        except Exception as exc:\n            raise RuntimeError(f\"Postgres probe failed: {exc}\") from exc\n        try:\n            topic_count = fetch_topic_count(require_env(\"REDPANDA_BROKER\"))\n        except Exception as exc:\n            raise RuntimeError(f\"Redpanda probe failed: {exc}\") from exc\n        try:\n            ch_count = fetch_ch_count(require_env(\"CLICKHOUSE_URL\"))\n        except Exception as exc:\n            raise RuntimeError(f\"ClickHouse probe failed: {exc}\") from exc\n        report = build_report(args.tolerance, pg_count, topic_count, ch_count)\n        write_report(report, args.report_path)\n        print(operator_summary(report, args.report_path))\n        return 0 if report[\"status\"] == \"ok\" else 2\n    except Exception as exc:\n        message = str(exc).lower()\n        if \"clickhouse\" in message or \"port 8123\" in message:\n            system = \"ClickHouse\"\n        elif \"kafka\" in message or \"broker\" in message or \"redpanda\" in message:\n            system = \"Redpanda\"\n        elif \"postgres\" in message or \"app.transactions\" in message:\n            system = \"Postgres\"\n        else:\n            system = \"dependency\"\n        print(f\"Reconciliation failed because {system} is unavailable or misconfigured: {exc}\", file=sys.stderr)\n        return 1\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n","exit_code":0,"status":"completed"}}
