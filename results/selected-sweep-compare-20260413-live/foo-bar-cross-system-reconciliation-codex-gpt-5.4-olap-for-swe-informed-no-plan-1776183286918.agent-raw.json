{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -lc \"chmod +x /workspace/scripts/reconcile.py && python3 - <<'PY'\nimport json, os\nimport psycopg2, clickhouse_connect\nfrom kafka import KafkaConsumer, KafkaProducer\nfrom urllib.parse import urlparse\n\npg = psycopg2.connect(os.environ['POSTGRES_URL'], connect_timeout=2)\nwith pg, pg.cursor() as cur:\n    cur.execute(\\\"SELECT id, customer_id, amount::float8, to_char(created_at AT TIME ZONE 'UTC', 'YYYY-MM-DD\\\\\\\"T\\\\\\\"HH24:MI:SS.MS\\\\\\\"Z\\\\\\\"') FROM app.transactions ORDER BY id\\\")\n    rows = cur.fetchall()\n\nparsed = urlparse(os.environ['CLICKHOUSE_URL'])\nch = clickhouse_connect.get_client(\n    host=parsed.hostname or 'localhost',\n    port=parsed.port or 8123,\n    username=parsed.username or 'default',\n    password=parsed.password or '',\n    database=(parsed.path or '/').lstrip('/') or 'default',\n    connect_timeout=2,\n    send_receive_timeout=2,\n)\nexisting_ch = set()\ntry:\n    result = ch.query('SELECT id FROM analytics.transactions ORDER BY id')\n    for row in result.result_rows:\n        existing_ch.add(int(row[0]))\n    missing_ch = [row for row in rows if int(row[0]) not in existing_ch]\n    if missing_ch:\n        ch.insert('analytics.transactions', missing_ch, column_names=['id', 'customer_id', 'amount', 'created_at'])\nfinally:\n    ch.close()\n\nconsumer = KafkaConsumer(\n    'transactions',\n    bootstrap_servers=[os.environ['REDPANDA_BROKER']],\n    auto_offset_reset='earliest',\n    enable_auto_commit=False,\n    consumer_timeout_ms=1200,\n    request_timeout_ms=2000,\n    api_version_auto_timeout_ms=1000,\n    value_deserializer=lambda b: json.loads(b.decode('utf-8')),\n)\nexisting_topic_ids = set()\nfor message in consumer:\n    value = message.value\n    if isinstance(value, dict) and 'id' in value:\n        existing_topic_ids.add(int(value['id']))\nconsumer.close()\n\nproducer = KafkaProducer(\n    bootstrap_servers=[os.environ['REDPANDA_BROKER']],\n    request_timeout_ms=2000,\n    value_serializer=lambda payload: json.dumps(payload, separators=(',', ':')).encode('utf-8'),\n)\nmissing_topic = [row for row in rows if int(row[0]) not in existing_topic_ids]\nfor row in missing_topic:\n    producer.send('transactions', key=str(row[0]).encode('utf-8'), value={\n        'id': int(row[0]),\n        'customer_id': row[1],\n        'amount': float(row[2]),\n        'created_at': row[3],\n    })\nproducer.flush(timeout=2)\nproducer.close()\n\nprint({'pg_rows': len(rows), 'inserted_clickhouse': len(missing_ch), 'published_topic': len(missing_topic)})\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
