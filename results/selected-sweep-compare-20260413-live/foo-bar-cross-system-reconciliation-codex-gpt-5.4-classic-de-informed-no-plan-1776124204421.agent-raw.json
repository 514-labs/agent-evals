{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json, os\nfrom urllib.parse import urlparse\n\nimport clickhouse_connect\nimport psycopg2\nfrom kafka import KafkaConsumer, KafkaProducer, TopicPartition\n\npg_conn = psycopg2.connect(os.environ['POSTGRES_URL'], connect_timeout=2)\npg_cur = pg_conn.cursor()\npg_cur.execute(\\\"SELECT id, customer_id, amount::float8, created_at AT TIME ZONE 'UTC' FROM app.transactions ORDER BY id\\\")\nrows = pg_cur.fetchall()\npg_count = len(rows)\n\nbroker = os.environ['REDPANDA_BROKER']\nconsumer = KafkaConsumer(\n    bootstrap_servers=[broker],\n    request_timeout_ms=2000,\n    consumer_timeout_ms=2000,\n    metadata_max_age_ms=1000,\n    api_version_auto_timeout_ms=2000,\n)\npartitions = consumer.partitions_for_topic('transactions') or set()\ntopic_count = 0\nif partitions:\n    tps = [TopicPartition('transactions', p) for p in sorted(partitions)]\n    ends = consumer.end_offsets(tps)\n    starts = consumer.beginning_offsets(tps)\n    topic_count = sum(max(int(ends.get(tp, 0)) - int(starts.get(tp, 0)), 0) for tp in tps)\nconsumer.close()\n\nif topic_count == 0:\n    producer = KafkaProducer(\n        bootstrap_servers=[broker],\n        request_timeout_ms=2000,\n        value_serializer=lambda value: json.dumps(value).encode('utf-8'),\n    )\n    for row in rows:\n        producer.send('transactions', {'id': row[0], 'customer_id': row[1], 'amount': row[2], 'created_at': row[3].isoformat() + 'Z'})\n    producer.flush(timeout=2)\n    producer.close()\n\nparsed = urlparse(os.environ['CLICKHOUSE_URL'])\nclient = clickhouse_connect.get_client(\n    host=parsed.hostname or 'localhost',\n    port=parsed.port or (8443 if parsed.scheme == 'https' else 8123),\n    username=parsed.username or 'default',\n    password=parsed.password or '',\n    database=(parsed.path or '/').lstrip('/') or 'default',\n    secure=parsed.scheme == 'https',\n    connect_timeout=2,\n    send_receive_timeout=2,\n)\nclient.command('TRUNCATE TABLE analytics.transactions')\nclient.insert('analytics.transactions', rows, column_names=['id', 'customer_id', 'amount', 'created_at'])\nch_count = client.query('SELECT count() FROM analytics.transactions').result_rows[0][0]\nclient.close()\n\npg_cur.close()\npg_conn.close()\nprint(json.dumps({'pg_count': pg_count, 'topic_seeded': topic_count == 0, 'clickhouse_count': int(ch_count)}))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
