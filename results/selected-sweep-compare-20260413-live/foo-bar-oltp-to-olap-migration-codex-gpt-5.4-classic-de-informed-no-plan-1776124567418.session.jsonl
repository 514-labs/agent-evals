{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -lc \"find /workspace -maxdepth 2 -type f | sort | xargs -I{} sh -c 'printf \\\"===== %s =====\\\\n\\\" \\\"\"'$1\"; sed -n \"1,220p\" \"$1\"'\"' sh {}\"","aggregated_output":"===== /workspace/README.md =====\n# OLTP to OLAP Sales Sync\n\n`sync_sales.py` copies `app.sales` from Postgres into `analytics.sales` in ClickHouse.\n\n## Behavior\n\n- Aligns the target schema to: `id`, `product_id`, `quantity`, `amount`, `sale_date`\n- Uses ClickHouse `MergeTree` ordering on `(sale_date, product_id, id)`\n- Performs incremental loads using `max(id)` already present in `analytics.sales`\n- Verifies `count` and `sum(amount)` between source and target after each run\n\n## Usage\n\n```bash\nPOSTGRES_URL=... CLICKHOUSE_URL=... python3 /workspace/sync_sales.py\n```\n\nThe script is dependency-free and uses the standard `psql` client plus ClickHouse's HTTP interface.\n===== /workspace/sync_sales.py =====\n#!/usr/bin/env python3\nimport csv\nimport io\nimport os\nimport subprocess\nimport sys\nimport urllib.parse\nimport urllib.request\nfrom dataclasses import dataclass\nfrom decimal import Decimal\n\n\nEXPECTED_SCHEMA = [\n    (\"id\", \"UInt32\"),\n    (\"product_id\", \"String\"),\n    (\"quantity\", \"Int32\"),\n    (\"amount\", \"Decimal(10, 2)\"),\n    (\"sale_date\", \"Date\"),\n]\n\n\n@dataclass\nclass ClickHouseConfig:\n    base_url: str\n    headers: dict[str, str]\n\n\ndef require_env(name: str) -> str:\n    value = os.environ.get(name)\n    if not value:\n        raise RuntimeError(f\"Missing required environment variable: {name}\")\n    return value\n\n\ndef parse_clickhouse_config() -> ClickHouseConfig:\n    raw_url = require_env(\"CLICKHOUSE_URL\")\n    parsed = urllib.parse.urlparse(raw_url)\n    if parsed.scheme not in {\"http\", \"https\"}:\n        raise RuntimeError(\"CLICKHOUSE_URL must use http or https\")\n\n    base_url = urllib.parse.urlunparse((parsed.scheme, parsed.netloc, parsed.path or \"/\", \"\", \"\", \"\"))\n    headers = {}\n    if parsed.username:\n        credentials = f\"{urllib.parse.unquote(parsed.username)}:{urllib.parse.unquote(parsed.password or '')}\"\n        headers[\"Authorization\"] = (\n            \"Basic \" + __import__(\"base64\").b64encode(credentials.encode(\"utf-8\")).decode(\"ascii\")\n        )\n    return ClickHouseConfig(base_url=base_url, headers=headers)\n\n\ndef ch_request(config: ClickHouseConfig, query: str, data: bytes | None = None) -> str:\n    encoded_query = urllib.parse.urlencode({\"query\": query})\n    url = f\"{config.base_url}?{encoded_query}\"\n    request = urllib.request.Request(url, data=data, method=\"POST\", headers=config.headers)\n    with urllib.request.urlopen(request, timeout=30) as response:\n        return response.read().decode(\"utf-8\")\n\n\ndef run_psql(sql: str) -> str:\n    postgres_url = require_env(\"POSTGRES_URL\")\n    result = subprocess.run(\n        [\"psql\", postgres_url, \"-v\", \"ON_ERROR_STOP=1\", \"-At\", \"-F\", \"\\t\", \"-c\", sql],\n        check=True,\n        capture_output=True,\n        text=True,\n    )\n    return result.stdout\n\n\ndef export_pg_csv(sql: str) -> bytes:\n    postgres_url = require_env(\"POSTGRES_URL\")\n    copy_sql = f\"COPY ({sql}) TO STDOUT WITH (FORMAT CSV)\"\n    result = subprocess.run(\n        [\"psql\", postgres_url, \"-v\", \"ON_ERROR_STOP=1\", \"-c\", copy_sql],\n        check=True,\n        capture_output=True,\n    )\n    return result.stdout\n\n\ndef table_exists(config: ClickHouseConfig) -> bool:\n    output = ch_request(\n        config,\n        \"SELECT count() FROM system.tables WHERE database = 'analytics' AND name = 'sales' FORMAT TSVRaw\",\n    ).strip()\n    return output == \"1\"\n\n\ndef read_schema(config: ClickHouseConfig) -> list[tuple[str, str]]:\n    output = ch_request(\n        config,\n        \"SELECT name, type FROM system.columns \"\n        \"WHERE database = 'analytics' AND table = 'sales' \"\n        \"ORDER BY position FORMAT TSVRaw\",\n    )\n    rows = []\n    for line in output.splitlines():\n        if not line.strip():\n            continue\n        name, column_type = line.split(\"\\t\", 1)\n        rows.append((name, column_type))\n    return rows\n\n\ndef ensure_target_schema(config: ClickHouseConfig) -> None:\n    ch_request(config, \"CREATE DATABASE IF NOT EXISTS analytics\")\n    if table_exists(config):\n        current_schema = read_schema(config)\n        if current_schema != EXPECTED_SCHEMA:\n            ch_request(config, \"DROP TABLE analytics.sales\")\n\n    if not table_exists(config):\n        ch_request(\n            config,\n            \"\"\"\n            CREATE TABLE analytics.sales (\n              id UInt32,\n              product_id String,\n              quantity Int32,\n              amount Decimal(10, 2),\n              sale_date Date\n            ) ENGINE = MergeTree()\n            ORDER BY (sale_date, product_id, id)\n            \"\"\".strip(),\n        )\n\n\ndef get_last_loaded_id(config: ClickHouseConfig) -> int:\n    output = ch_request(\n        config,\n        \"SELECT coalesce(max(id), 0) FROM analytics.sales FORMAT TSVRaw\",\n    ).strip()\n    return int(output or \"0\")\n\n\ndef fetch_new_sales(last_loaded_id: int) -> bytes:\n    sql = f\"\"\"\n        SELECT\n          id,\n          product_id,\n          quantity,\n          amount::numeric(10, 2),\n          sale_date\n        FROM app.sales\n        WHERE id > {last_loaded_id}\n        ORDER BY id\n    \"\"\".strip()\n    return export_pg_csv(sql)\n\n\ndef insert_sales(config: ClickHouseConfig, csv_payload: bytes) -> int:\n    if not csv_payload.strip():\n        return 0\n    rows = list(csv.reader(io.StringIO(csv_payload.decode(\"utf-8\"))))\n    if not rows:\n        return 0\n    ch_request(\n        config,\n        \"INSERT INTO analytics.sales (id, product_id, quantity, amount, sale_date) FORMAT CSV\",\n        data=csv_payload,\n    )\n    return len(rows)\n\n\ndef fetch_pg_metrics() -> tuple[int, Decimal]:\n    output = run_psql(\n        \"\"\"\n        SELECT\n          count(id),\n          coalesce(sum(amount), 0)::numeric(10, 2)\n        FROM app.sales\n        \"\"\".strip()\n    ).strip()\n    count_text, sum_text = output.split(\"\\t\", 1)\n    return int(count_text), Decimal(sum_text)\n\n\ndef fetch_ch_metrics(config: ClickHouseConfig) -> tuple[int, Decimal]:\n    output = ch_request(\n        config,\n        \"\"\"\n        SELECT\n          count(),\n          coalesce(sum(amount), toDecimal64(0, 2))\n        FROM analytics.sales\n        FORMAT TSVRaw\n        \"\"\".strip(),\n    ).strip()\n    count_text, sum_text = output.split(\"\\t\", 1)\n    return int(count_text), Decimal(sum_text)\n\n\ndef main() -> int:\n    config = parse_clickhouse_config()\n    ensure_target_schema(config)\n\n    last_loaded_id = get_last_loaded_id(config)\n    new_rows_csv = fetch_new_sales(last_loaded_id)\n    inserted_rows = insert_sales(config, new_rows_csv)\n\n    pg_count, pg_sum = fetch_pg_metrics()\n    ch_count, ch_sum = fetch_ch_metrics(config)\n    if (pg_count, pg_sum) != (ch_count, ch_sum):\n        print(\n            \"Checksum mismatch:\",\n            f\"postgres(count={pg_count}, sum={pg_sum})\",\n            f\"clickhouse(count={ch_count}, sum={ch_sum})\",\n            file=sys.stderr,\n        )\n        return 1\n\n    print(\n        f\"Synced analytics.sales successfully. inserted_rows={inserted_rows} \"\n        f\"last_loaded_id={last_loaded_id} count={ch_count} sum={ch_sum}\"\n    )\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n","exit_code":0,"status":"completed"}}
