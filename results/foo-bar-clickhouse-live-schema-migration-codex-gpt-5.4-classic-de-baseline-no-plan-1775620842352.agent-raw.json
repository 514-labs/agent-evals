e: passed ? \"Region column exists.\" : \"Region column missing.\",\n    details: { columnCount: rows.length },\n  };\n}\n\nexport async function table_has_rows(ctx: AssertionContext): Promise<AssertionResult> {\n  const rows = await queryRows<{ n: number }>(ctx, \"SELECT count() AS n FROM analytics.events\");\n  const count = Number(rows[0]?.n ?? 0);\n  const passed = count > 0;\n  return {\n    passed,\n    message: passed ? \"Table has rows.\" : \"Table is empty.\",\n    details: { count },\n  };\n}\nFILE /scenario/assertions/performant.ts\nimport type { AssertionContext, AssertionResult } from \"@dec-bench/eval-core\";\n\nimport { avoidsSelectStarQueries, scanWorkspaceForHardcodedConnections } from \"../../_shared/assertion-helpers\";\n\nexport async function query_with_region_under_100ms(ctx: AssertionContext): Promise<AssertionResult> {\n  const start = Date.now();\n  await ctx.clickhouse.query({\n    query: \"SELECT event_id, region FROM analytics.events LIMIT 10\",\n    format: \"JSONEachRow\",\n  });\n  const elapsed = Date.now() - start;\n  const passed = elapsed < 100;\n  return {\n    passed,\n    message: passed ? \"Query with region under 100ms.\" : `Query took ${elapsed}ms.`,\n    details: { elapsedMs: elapsed },\n  };\n}\n\nexport async function avoids_select_star_queries(): Promise<AssertionResult> {\n  return avoidsSelectStarQueries();\n}\nFILE /scenario/assertions/production.ts\nimport type { AssertionContext, AssertionResult } from \"@dec-bench/eval-core\";\n\nimport { hasReadmeOrDocs, scanWorkspaceForHardcodedConnections } from \"../../_shared/assertion-helpers\";\n\nexport async function connection_env_vars_available(ctx: AssertionContext): Promise<AssertionResult> {\n  const hasClickHouse = Boolean(ctx.env(\"CLICKHOUSE_URL\"));\n  const passed = hasClickHouse;\n  return {\n    passed,\n    message: passed ? \"Connection env vars available.\" : \"Missing CLICKHOUSE_URL.\",\n    details: { hasClickHouse },\n  };\n}\n\nexport async function no_hardcoded_connection_strings(): Promise<AssertionResult> {\n  return scanWorkspaceForHardcodedConnections();\n}\n\nexport async function has_readme_or_docs(): Promise<AssertionResult> {\n  return hasReadmeOrDocs();\n}\nFILE /scenario/assertions/robust.ts\nimport type { AssertionContext, AssertionResult } from \"@dec-bench/eval-core\";\n\nimport { avoidsSelectStarQueries, scanWorkspaceForHardcodedConnections } from \"../../_shared/assertion-helpers\";\n\nexport async function select_star_works(ctx: AssertionContext): Promise<AssertionResult> {\n  const result = await ctx.clickhouse.query({\n    query: \"SELECT * FROM analytics.events LIMIT 1\",\n    format: \"JSONEachRow\",\n  });\n  const rows = (await (result as any).json()) as Record<string, unknown>[];\n  const passed = rows.length === 1 && rows[0] && Object.keys(rows[0]).length >= 4;\n  return {\n    passed,\n    message: passed ? \"SELECT * works.\" : \"SELECT * failed or returned wrong shape.\",\n    details: { rowCount: rows.length },\n  };\n}\n\nexport async function no_hardcoded_connection_strings(): Promise<AssertionResult> {\n  return scanWorkspaceForHardcodedConnections();\n}\n","exit_code":0,"status":"completed"}}
