{"type":"item.started","item":{"id":"item_68","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json\nimport time\nimport urllib.request\n\nCLICKHOUSE_URL = 'http://localhost:8123'\n\ndef ch(query: str):\n    req = urllib.request.Request(CLICKHOUSE_URL, data=query.encode(), method='POST')\n    with urllib.request.urlopen(req, timeout=30) as r:\n        body = r.read().decode().strip()\n    rows = [json.loads(line) for line in body.splitlines() if line]\n    return rows\n\nraw_metrics = ch(\\\"SELECT count() AS total, uniq(user_id) AS users, sum(revenue) AS revenue FROM analytics.events FORMAT JSONEachRow\\\")[0]\nrollup_metrics = ch(\\\"SELECT countMerge(total_events_state) AS total, uniqMerge(unique_users_state) AS users, sumMerge(total_revenue_state) AS revenue FROM analytics.metrics_rollup FORMAT JSONEachRow\\\")[0]\nraw_breakdown_count = ch(\\\"SELECT count() AS cnt FROM (SELECT region, toDate(event_ts) AS day, count() AS c FROM analytics.events GROUP BY region, day) FORMAT JSONEachRow\\\")[0]['cnt']\nrollup_breakdown_count = ch(\\\"SELECT count() AS cnt FROM (SELECT region, day, sum(cnt) AS c FROM analytics.breakdown_rollup GROUP BY region, day) FORMAT JSONEachRow\\\")[0]['cnt']\nprint('metrics_match=', raw_metrics == rollup_metrics)\nprint('breakdown_rows_match=', raw_breakdown_count == rollup_breakdown_count)\n\nfor path in ['/api/metrics', '/api/breakdown']:\n    timings = []\n    body = None\n    for _ in range(5):\n        start = time.perf_counter()\n        with urllib.request.urlopen(f'http://localhost:3000{path}', timeout=5) as r:\n            body = r.read().decode()\n        timings.append((time.perf_counter() - start) * 1000)\n    print(path, 'timings_ms=', [round(t, 2) for t in timings], 'max_ms=', round(max(timings), 2))\n    print(path, 'sample=', body[:160])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
